# Story planning LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Main media path: gemini for creator-quality cloud output, comfy for local workflows
MEDIA_PROVIDER=gemini

# Gemini image + Veo video generation
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Fast is recommended while iterating. Switch to veo-3.1-generate-preview for final shots.
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_VIDEO_DURATION=8
GEMINI_POLL_SECONDS=10

# Local ComfyUI fallback / experimental open-model path
COMFYUI_URL=http://127.0.0.1:8188
COMFY_IMAGE_WORKFLOW=workflows/image_api.json
COMFY_VIDEO_WORKFLOW=workflows/video_api.json

# Controlled narration/dialogue. 'edge' is free fallback; 'http' can point to CosyVoice/F5-TTS service.
TTS_PROVIDER=edge
TTS_HTTP_URL=
EDGE_TTS_VOICE=

# Delivery
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
BASE_SEED=42
