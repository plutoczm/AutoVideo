# -----------------------------------------------------------------------------
# LLM provider: gemini | doubao | deepseek
# Free-first default: Gemini 3.6 Flash currently has a Gemini API free tier.
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Gemini API (used by Gemini LLM and, optionally, Gemini image/video media)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash

# Volcengine Ark / Doubao
# One ARK_API_KEY can be used for Doubao LLM, Seedream image and Seedance video APIs.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
DOUBAO_LLM_MODEL=doubao-seed-2-1-turbo-260628

# DeepSeek optional fallback. deepseek-chat/reasoner were retired in July 2026.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# -----------------------------------------------------------------------------
# Media provider: doubao | gemini | comfy
# Free-first default: Doubao because Ark currently advertises trial quotas for
# Seedream and Seedance. Quotas/activation are account-specific and can expire.
# -----------------------------------------------------------------------------
MEDIA_PROVIDER=doubao

# Doubao Seedream + Seedance
DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
DOUBAO_IMAGE_SIZE=2K
DOUBAO_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
DOUBAO_VIDEO_RATIO=9:16
DOUBAO_VIDEO_DURATION=5
DOUBAO_POLL_SECONDS=8
DOUBAO_MAX_WAIT_SECONDS=900

# Gemini image + video alternative.
# Gemini API video generation is currently paid-tier, so it is not the free-first default.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_VIDEO_DURATION=8
GEMINI_POLL_SECONDS=10

# Local ComfyUI alternative. API cost is zero, but you provide the GPU/models.
COMFYUI_URL=http://127.0.0.1:8188
COMFY_IMAGE_WORKFLOW=workflows/image_api.json
COMFY_VIDEO_WORKFLOW=workflows/video_api.json

# Controlled narration/dialogue. Edge-TTS is the no-key fallback.
TTS_PROVIDER=edge
TTS_HTTP_URL=
EDGE_TTS_VOICE=

# Delivery
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
BASE_SEED=42
