# Google Generative AI
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face Inference API for Stable Diffusion
HF_TOKEN=
SD_API_URL=https://api-inference.huggingface.co/models/CompVis/stable-diffusion-v1-4

# Edge-TTS voice, e.g. zh-CN-XiaoxiaoNeural / en-US-JennyNeural
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Optional: local font name/path used by MoviePy TextClip for subtitles
SUBTITLE_FONT=
